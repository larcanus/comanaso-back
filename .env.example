# Database Configuration
DATABASE_URL=postgresql+asyncpg://comanaso:100@localhost:5432/comanaso
DB_PASSWORD=change_this_secure_password_in_production

# JWT Configuration
JWT_SECRET=change_this_super_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration (разделенные запятой origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://domain.com

# Application Settings
DEBUG=false
LOG_LEVEL=info
ENVIRONMENT=development
PROJECT_NAME='Comanaso API'
VERSION=1.0.0

# Email Configuration (beget)
SMTP_HOST=smtp.provider.com
SMTP_PORT=465
SMTP_USER=name@domain.ru
SMTP_PASSWORD=8+_characters
SMTP_FROM_NAME='Comanaso Support'
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
FRONTEND_URL=https://domain.com